<UserControl x:Class="TianMu.Modules.Sense.Views.SystemPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TianMu.Modules.Sense.Views">
    <!-- 周天運轉：左 CPU 環、中記憶體環、右網路上下行 -->
    <Grid Margin="20,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="15"
                   Foreground="{DynamicResource YueBaiBrush}" Text="周天運轉" />

        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel HorizontalAlignment="Center">
                <Grid Width="78" Height="78">
                    <local:ProgressRing Thickness="5" Progress="{Binding Cpu}" RingBrush="{DynamicResource MiaoJinBrush}" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{DynamicResource SerifMediumFont}" FontSize="19"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource YueBaiBrush}" Text="{Binding CpuText}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Text="CPU" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <Grid Width="78" Height="78">
                    <local:ProgressRing Thickness="5" Progress="{Binding Memory}" RingBrush="{DynamicResource TianQingBrush}" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{DynamicResource SerifMediumFont}" FontSize="19"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource YueBaiBrush}" Text="{Binding MemoryText}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Text="記憶體" />
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="↓ 下載" />
                <TextBlock Margin="0,2,0,0" FontFamily="{DynamicResource SerifMediumFont}" FontSize="16"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource YueBaiBrush}" Text="{Binding DownText}" />
                <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="↑ 上傳" />
                <TextBlock Margin="0,2,0,0" FontFamily="{DynamicResource SerifMediumFont}" FontSize="16"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource YueBaiBrush}" Text="{Binding UpText}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
