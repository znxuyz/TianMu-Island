<UserControl x:Class="TianMu.Modules.Sense.Views.ProgressPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TianMu.Modules.Sense.Views">
    <!-- 展開態：左大圓環（中間百分比），右程式名稱與說明 -->
    <Grid Margin="28,0,28,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Width="104" Height="104" VerticalAlignment="Center">
            <local:ProgressRing Thickness="6" Progress="{Binding Progress}" RingBrush="{DynamicResource TianQingBrush}" />
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{DynamicResource SerifMediumFont}" FontSize="26"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource YueBaiBrush}" Text="{Binding PercentText}" />
        </Grid>

        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="12" Foreground="{DynamicResource TianQingBrush}" Text="煉化中" />
            <TextBlock Margin="0,6,0,0" FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="22"
                       Foreground="{DynamicResource YueBaiBrush}" Text="{Binding App}" TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="工作列上的下載、複製或安裝進度" />
        </StackPanel>
    </Grid>
</UserControl>
