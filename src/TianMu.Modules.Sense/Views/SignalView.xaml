<UserControl x:Class="TianMu.Modules.Sense.Views.SignalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- 感應提示：左圖示、中文字（或刻度條）、右數值 -->
    <Grid Margin="16,0,20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Icon" Width="36" Height="36" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Ellipse Fill="{DynamicResource HoverFillBrush}" />
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{DynamicResource IconFont}" FontSize="16"
                       Foreground="{Binding Accent}" Text="{Binding Glyph}" />
        </Grid>

        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
            <TextBlock FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="15"
                       Foreground="{DynamicResource YueBaiBrush}" Text="{Binding Title, NotifyOnTargetUpdated=True}"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- 翻牌：圖示轉過來亮相 -->
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Icon"
                                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1.15">
                                        <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />

            <!-- 刻度條（音量、亮度） -->
            <Grid Height="4" Margin="0,7,0,0" Visibility="{Binding HasLevel, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="2" Background="{DynamicResource TrackBrush}" />
                <Border CornerRadius="2" Background="{Binding Accent}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Level}" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="{DynamicResource SerifMediumFont}"
                   FontSize="20" Typography.NumeralAlignment="Tabular"
                   Foreground="{DynamicResource YueBaiBrush}" Text="{Binding LevelText}" />
    </Grid>
</UserControl>
