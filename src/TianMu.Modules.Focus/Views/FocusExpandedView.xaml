<UserControl x:Class="TianMu.Modules.Focus.Views.FocusExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TianMu.Modules.Focus.Views">
    <!-- 展開態：左大圓環（倒數與回數），右側境界與操作 -->
    <Grid Margin="22,16,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Width="108" Height="108" VerticalAlignment="Center">
            <local:ProgressRing x:Name="Ring" Thickness="4" Progress="{Binding Progress}"
                                RingBrush="{DynamicResource MiaoJinBrush}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" FontFamily="{DynamicResource SerifMediumFont}" FontSize="27"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource YueBaiBrush}" Text="{Binding TimeText}" />
                <TextBlock HorizontalAlignment="Center" Margin="0,1,0,0" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding RoundText}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Margin="22,4,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="Status" FontSize="12" Foreground="{DynamicResource MiaoJinBrush}"
                       Text="{Binding StatusLabel, NotifyOnTargetUpdated=True}" TextTrimming="CharacterEllipsis">
                <TextBlock.Triggers>
                    <!-- 墨暈：狀態文字改變時由模糊暈開 -->
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <TextBlock Margin="0,6,0,0" FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="19"
                       Foreground="{DynamicResource YueBaiBrush}" Text="{Binding RealmTitle}" />

            <Grid Height="3" Margin="0,10,0,0">
                <Border CornerRadius="1.5" Background="{DynamicResource TrackBrush}" />
                <Border CornerRadius="1.5" Background="{DynamicResource MiaoJinBrush}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding RealmProgress}" />
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding RealmHint}" TextTrimming="CharacterEllipsis" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="PauseButton" Style="{DynamicResource TianMu.Button.Ghost}" MinHeight="30" Padding="14,0"
                        Content="{Binding PauseLabel}" Command="{Binding PauseResumeCommand}" Focusable="False" />
                <Button x:Name="AbandonButton" Style="{DynamicResource TianMu.Button.Ghost}" MinHeight="30" Padding="14,0"
                        Margin="8,0,0,0" Content="散功" ToolTip="放棄這一回（已專注的時間仍計入修為）"
                        Command="{Binding AbandonCommand}" Focusable="False" />
                <Button x:Name="SkipButton" Style="{DynamicResource TianMu.Button.Ghost}" MinHeight="30" Padding="14,0"
                        Margin="8,0,0,0" Content="出定" ToolTip="結束調息"
                        Command="{Binding SkipBreakCommand}" Focusable="False" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
