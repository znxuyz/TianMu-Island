<UserControl x:Class="TianMu.Modules.Todo.Views.TodoReminderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 天機已至：左朱砂「令」印，中間待辦內容，右側完成／稍後 -->
    <Grid Margin="22,0,20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Seal" Width="46" Height="46" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Ellipse Fill="{DynamicResource ZhuShaBrush}" />
            <Ellipse Margin="3" Stroke="#66F4EEE2" StrokeThickness="1" />
            <TextBlock Text="令" FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="21"
                       Foreground="#FFF4EEE2" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Grid.Triggers>
                <!-- 出現時印章落下 -->
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="1.5" To="1" Duration="0:0:0.35">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="1.5" To="1" Duration="0:0:0.35">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>

        <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
            <TextBlock FontSize="11" Foreground="{DynamicResource ZhuShaBrush}" Text="{Binding When}" />
            <TextBlock Margin="0,4,0,0" FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="17"
                       Foreground="{DynamicResource YueBaiBrush}" Text="{Binding Text}"
                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="46" />
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Button Style="{DynamicResource TianMu.Button.Primary}" MinHeight="28" Padding="16,0"
                    Content="完成" Command="{Binding DoneCommand}" Focusable="False" />
            <Button Style="{DynamicResource TianMu.Button.Ghost}" MinHeight="28" Padding="12,0" Margin="0,6,0,0"
                    Content="十分鐘後" ToolTip="10 分鐘後再提醒" Command="{Binding LaterCommand}" Focusable="False" />
        </StackPanel>
    </Grid>
</UserControl>
