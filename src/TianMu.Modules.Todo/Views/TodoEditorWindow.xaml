<Window x:Class="TianMu.Modules.Todo.Views.TodoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="記一筆"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource XuanQiBrush}"
        Foreground="{DynamicResource YueBaiBrush}"
        FontFamily="{DynamicResource SansFont}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 玄漆輸入框：底線描金，聚焦時亮起 -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource YueBaiBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource MiaoJinBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource MiaoJinBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" CornerRadius="8" Background="{DynamicResource HoverFillBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MiaoJinBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Padding="10,4" Background="{DynamicResource HoverFillBrush}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GoldFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource LacquerBrush}">
        <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource TopHairlineBrush}" />

        <StackPanel Margin="26,20,26,22">
            <Grid>
                <TextBlock FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="20" Text="記一筆" />
                <Button HorizontalAlignment="Right" Style="{DynamicResource TianMu.Button.Icon}" Content="&#xE8BB;"
                        ToolTip="關閉" AutomationProperties.Name="關閉" WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Close_Click" />
            </Grid>

            <TextBlock Margin="0,14,0,6" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="要做什麼" />
            <TextBox x:Name="TextField" Style="{StaticResource Field}" MaxLength="120"
                     AutomationProperties.Name="要做什麼" TextChanged="Field_TextChanged" />

            <TextBlock Margin="0,14,0,6" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="什麼時候提醒" />
            <TextBox x:Name="TimeField" Style="{StaticResource Field}" MaxLength="40"
                     AutomationProperties.Name="什麼時候提醒" TextChanged="Field_TextChanged" />

            <WrapPanel Margin="0,8,0,0">
                <Button Style="{StaticResource Chip}" Content="30 分鐘後" Tag="30分" Click="Chip_Click" />
                <Button Style="{StaticResource Chip}" Content="1 小時後" Tag="1小時" Click="Chip_Click" />
                <Button Style="{StaticResource Chip}" Content="今晚 8 點" Tag="今晚8點" Click="Chip_Click" />
                <Button Style="{StaticResource Chip}" Content="明早 9 點" Tag="明早9點" Click="Chip_Click" />
            </WrapPanel>

            <TextBlock x:Name="Preview" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="可以寫「15:30」「下午 3 點」「明天 9 點」「11/20 14:00」「45 分」" />

            <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource TianMu.Button.Ghost}" Content="取消" Click="Close_Click" />
                <Button x:Name="SaveButton" Margin="8,0,0,0" Style="{DynamicResource TianMu.Button.Primary}"
                        Content="記下" IsEnabled="False" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
