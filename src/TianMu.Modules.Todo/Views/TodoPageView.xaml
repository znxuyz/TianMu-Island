<UserControl x:Class="TianMu.Modules.Todo.Views.TodoPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 天機簿：接下來的待辦，最多四件；點圓圈即完成 -->
    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="15"
                       Foreground="{DynamicResource YueBaiBrush}" Text="{Binding Title}" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Style="{DynamicResource TianMu.Button.Ghost}" MinHeight="26" Padding="12,0"
                    FontSize="12" Content="＋ 記一筆" Command="{Binding AddCommand}" Focusable="False" />
        </Grid>

        <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 完成鈕：空心圓，滑過時泛金 -->
                        <Button Command="{Binding DoneCommand}" Focusable="False" Cursor="Hand" ToolTip="完成"
                                Width="18" Height="18" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Ellipse x:Name="Ring" Width="14" Height="14" Stroke="{DynamicResource TextTertiaryBrush}"
                                                 StrokeThickness="1.3" />
                                        <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="8"
                                                   Foreground="{DynamicResource MiaoJinBrush}" Opacity="0"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource MiaoJinBrush}" />
                                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource YueBaiBrush}" Text="{Binding Text}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="When" Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding When}" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Overdue}" Value="True">
                            <Setter TargetName="When" Property="Foreground" Value="{DynamicResource ZhuShaBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="2" HorizontalAlignment="Right" FontSize="11"
                   Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding More}" />
    </Grid>
</UserControl>
