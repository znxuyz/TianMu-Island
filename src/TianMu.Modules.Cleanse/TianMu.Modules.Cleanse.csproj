<Project Sdk="Microsoft.NET.Sdk">

  <!--
    洗髓：磁碟空間守護。低空間提醒、找出可清理的快取與大檔案、使用者勾選確認後才清理。
    功能構想參考 RabbittuX/purrge（PolyForm Noncommercial），程式碼與規則清單為天幕島自行撰寫，未複製其原始碼。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>TianMu.Modules.Cleanse</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianMu.Core\TianMu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TianMu.Tests" />
  </ItemGroup>

</Project>
