<Window x:Class="TianMu.Modules.Cleanse.Views.CleanseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="洗髓 · 磁碟清理"
        Width="820" Height="760" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource XuanQiBrush}"
        Foreground="{DynamicResource YueBaiBrush}"
        FontFamily="{DynamicResource SansFont}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{DynamicResource LacquerBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標頭 -->
        <Grid Margin="28,18,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="5" Background="{DynamicResource ZhuShaBrush}" VerticalAlignment="Center">
                <Border Margin="3" CornerRadius="3" BorderThickness="1" BorderBrush="#66F4EEE2">
                    <TextBlock Text="洗" FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="20"
                               Foreground="#FFF4EEE2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="洗髓" FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="22" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="磁碟清理 · 逐項說明，你勾選確認後才清；你的檔案先進資源回收筒" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{DynamicResource TianMu.Button.Icon}" Content="&#xE921;" ToolTip="最小化"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" />
                <Button Style="{DynamicResource TianMu.Button.Icon}" Content="&#xE8BB;" ToolTip="關閉"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- 磁碟用量與掃描 -->
        <Grid Grid.Row="1" Margin="28,10,28,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="14" Text="{Binding DiskText}" />
                <Grid Height="6" Margin="0,8,0,0">
                    <Border CornerRadius="3" Background="{DynamicResource TrackBrush}" />
                    <Border x:Name="UsedBar" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource MiaoJinBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiskLow}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ZhuShaBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Status}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource TianMu.Button.Ghost}" Content="停止" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Style="{DynamicResource TianMu.Button.Primary}" Content="掃描" Command="{Binding ScanCommand}" />
            </StackPanel>
        </Grid>

        <!-- 審查清單 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl Margin="28,4,28,16" ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Visibility="{Binding Visibility}" Margin="0,14,0,0">
                            <Grid>
                                <TextBlock FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="17"
                                           Foreground="{DynamicResource MiaoJinBrush}" Text="{Binding Title}" />
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Total}" />
                            </Grid>
                            <TextBlock Margin="0,2,0,6" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding Hint}" />
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource HairlineBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{DynamicResource TianMu.Toggle}" VerticalAlignment="Center" Margin="0,0,14,0"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}"
                                                          AutomationProperties.Name="{Binding Name}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="15"
                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" Text="{Binding Reason}" />
                                                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis" Text="{Binding ShownPath}" ToolTip="{Binding ShownPath}" />
                                                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TianQingBrush}"
                                                               Text="{Binding Status}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15"
                                                           FontFamily="{DynamicResource SerifFont}" Text="{Binding SizeText}" />
                                                <Button Grid.Column="3" Margin="8,0,0,0" Style="{DynamicResource TianMu.Button.Icon}"
                                                        Content="&#xE838;" ToolTip="在檔案總管裡看看" Command="{Binding OpenCommand}"
                                                        IsEnabled="{Binding CanOpen}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部：已勾選與清理 -->
        <Border Grid.Row="3" Padding="28,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairlineBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13" Text="{Binding SelectedText}" />
                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource MiaoJinBrush}" TextWrapping="Wrap"
                               Text="{Binding Summary}" />
                </StackPanel>
                <Button Grid.Column="1" Margin="16,0,0,0" Style="{DynamicResource TianMu.Button.Primary}" Padding="22,0"
                        Content="{Binding CleanLabel}" Command="{Binding CleanCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
