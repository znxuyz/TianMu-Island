<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      天幕島設計語言「玄漆描金」的唯一真實來源。
      規則：一個光源（只有頂緣描金）、一處重彩（朱砂最多一處）、三層為限、墨暈而現、器有其色。
      任何畫面都只能引用這裡的資源，不可自行寫死色碼。
    -->

    <!-- ═══ 五色 ═══ -->
    <Color x:Key="XuanQiColor">#FF0E0C0A</Color>        <!-- 玄漆：本體 -->
    <Color x:Key="XuanQiTopColor">#FF1C1915</Color>     <!-- 玄漆受光面 -->
    <Color x:Key="XuanQiDeepColor">#FF0A0907</Color>    <!-- 玄漆背光面 -->
    <Color x:Key="MiaoJinColor">#FFC8A869</Color>       <!-- 描金：主強調、專注、修為 -->
    <Color x:Key="MiaoJinBrightColor">#FFE6CF98</Color> <!-- 描金高光：頂線 -->
    <Color x:Key="YueBaiColor">#FFECE6D8</Color>        <!-- 月白：文字 -->
    <Color x:Key="TianQingColor">#FF8FB3AD</Color>      <!-- 天青：飲水、健康 -->
    <Color x:Key="ZhuShaColor">#FFB23A27</Color>        <!-- 朱砂：印章、緊急、渡劫 -->

    <SolidColorBrush x:Key="XuanQiBrush" Color="{StaticResource XuanQiColor}" />
    <SolidColorBrush x:Key="MiaoJinBrush" Color="{StaticResource MiaoJinColor}" />
    <SolidColorBrush x:Key="YueBaiBrush" Color="{StaticResource YueBaiColor}" />
    <SolidColorBrush x:Key="TianQingBrush" Color="{StaticResource TianQingColor}" />
    <SolidColorBrush x:Key="ZhuShaBrush" Color="{StaticResource ZhuShaColor}" />

    <!-- 月白的透明層級：主文 / 次文 / 提示 / 分隔線 / 底軌 -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9EECE6D8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6BECE6D8" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#17ECE6D8" />
    <SolidColorBrush x:Key="TrackBrush" Color="#24ECE6D8" />
    <SolidColorBrush x:Key="HoverFillBrush" Color="#14ECE6D8" />
    <SolidColorBrush x:Key="GoldFillBrush" Color="#1FC8A869" />

    <!-- 漆面：由上而下的受光漸層 -->
    <LinearGradientBrush x:Key="LacquerBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource XuanQiTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource XuanQiColor}" Offset="0.45" />
        <GradientStop Color="{StaticResource XuanQiDeepColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- 描金頂線：只在中段發亮，兩側淡出 -->
    <LinearGradientBrush x:Key="TopHairlineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00E6CF98" Offset="0.14" />
        <GradientStop Color="#D9E6CF98" Offset="0.5" />
        <GradientStop Color="#00E6CF98" Offset="0.86" />
    </LinearGradientBrush>

    <!-- ═══ 字 ═══ -->
    <!-- 宋體：內嵌思源宋體（只含介面用到的字），缺字時退回微軟正黑體 -->
    <FontFamily x:Key="SerifFont">pack://application:,,,/TianMuIsland;component/Assets/Fonts/#Noto Serif TC, Microsoft JhengHei UI</FontFamily>
    <!-- 宋體中字重：時間與數字（搭配 FontWeight="Normal" 使用） -->
    <FontFamily x:Key="SerifMediumFont">pack://application:,,,/TianMuIsland;component/Assets/Fonts/#Noto Serif TC Medium, Microsoft JhengHei UI</FontFamily>
    <!-- 黑體：動態內容（歌名、訊息），用系統字型確保任何字都顯示得出來 -->
    <FontFamily x:Key="SansFont">Microsoft JhengHei UI, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ═══ 動態 ═══ -->
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <Duration x:Key="FastDuration">0:0:0.18</Duration>

    <!-- ═══ 元件樣式 ═══ -->

    <!-- 開關：描金軌道 -->
    <Style x:Key="TianMu.Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="24" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="12" Background="{StaticResource TrackBrush}" />
                        <Border x:Name="FocusRing" CornerRadius="14" Margin="-3" BorderThickness="1.5"
                                BorderBrush="{StaticResource MiaoJinBrush}" Opacity="0" />
                        <Ellipse x:Name="Thumb" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0,0,0"
                                 Fill="{StaticResource YueBaiBrush}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource MiaoJinBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource XuanQiBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="20" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 按鈕：描金實心（主要動作，一個畫面一個） -->
    <Style x:Key="TianMu.Button.Primary" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource XuanQiBrush}" />
        <Setter Property="Background" Value="{StaticResource MiaoJinBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="17" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" BorderThickness="1.5" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource YueBaiBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 按鈕：細框（次要動作） -->
    <Style x:Key="TianMu.Button.Ghost" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource YueBaiBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="17" Background="Transparent" BorderThickness="1"
                            BorderBrush="{StaticResource TrackBrush}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverFillBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource MiaoJinBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource MiaoJinBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 圖示按鈕（視窗關閉、最小化） -->
    <Style x:Key="TianMu.Button.Icon" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverFillBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource YueBaiBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverFillBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 右鍵 / 系統匣選單 -->
    <Style x:Key="TianMu.ContextMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="10" CornerRadius="14" Background="{StaticResource LacquerBrush}" Padding="6"
                            MinWidth="200">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Rectangle Height="1" VerticalAlignment="Top" Margin="8,-6,8,0" Fill="{StaticResource TopHairlineBrush}" />
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TianMu.MenuItem" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource YueBaiBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" CornerRadius="9" Background="Transparent" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0"
                                       Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverFillBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 強調項目（例如「更新至新版」）：描金字 -->
    <Style x:Key="TianMu.MenuItem.Accent" TargetType="MenuItem" BasedOn="{StaticResource TianMu.MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource MiaoJinBrush}" />
    </Style>

    <Style x:Key="TianMu.Separator" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Margin="10,5" Fill="{StaticResource HairlineBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 細捲軸：平時幾乎隱形，滑過才浮現 -->
    <Style x:Key="TianMu.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="3" Background="{StaticResource TrackBrush}" Width="5" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource MiaoJinBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource TianMu.ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
