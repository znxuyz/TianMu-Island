<Project Sdk="Microsoft.NET.Sdk">

  <!--
    天幕島主程式（宿主）。
    TargetFramework 帶上 windows10.0.19041.0，可直接呼叫 WinRT API
    （之後的音樂接管 GlobalSystemMediaTransportControls、系統通知監聽都靠它）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>TianMuIsland</AssemblyName>
    <RootNamespace>TianMu.Island</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 打包成單一 .exe 的設定（dotnet publish 時生效） -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianMu.Core\TianMu.Core.csproj" />
    <ProjectReference Include="..\TianMu.Modules.Music\TianMu.Modules.Music.csproj" />
  </ItemGroup>

</Project>
