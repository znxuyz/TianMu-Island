<Project Sdk="Microsoft.NET.Sdk">

  <!--
    天幕島主程式（宿主）。
    TargetFramework 帶上 windows10.0.19041.0，可直接呼叫 WinRT API
    （之後的音樂接管 GlobalSystemMediaTransportControls、系統通知監聽都靠它）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- 只為了系統匣圖示（NotifyIcon）；WinForms 的命名空間不全域匯入，避免和 WPF 撞名 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\TianMu.ico</ApplicationIcon>
    <!-- WFO0003 建議改用 WinForms 的 DPI 設定；但本程式的介面是 WPF，DPI 必須由 app.manifest 宣告 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>TianMuIsland</AssemblyName>
    <RootNamespace>TianMu.Island</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 打包成單一 .exe 的設定（dotnet publish 時生效） -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- 圖示與內嵌字型（字型由 scripts/build-fonts.py 依介面用字裁切產生） -->
    <Resource Include="Assets\TianMu.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianMu.Core\TianMu.Core.csproj" />
    <ProjectReference Include="..\TianMu.Modules.Music\TianMu.Modules.Music.csproj" />
    <ProjectReference Include="..\TianMu.Modules.Focus\TianMu.Modules.Focus.csproj" />
    <ProjectReference Include="..\TianMu.Modules.Ai\TianMu.Modules.Ai.csproj" />
    <ProjectReference Include="..\TianMu.Modules.Sense\TianMu.Modules.Sense.csproj" />
    <ProjectReference Include="..\TianMu.Modules.Notify\TianMu.Modules.Notify.csproj" />
    <ProjectReference Include="..\TianMu.Modules.Shelf\TianMu.Modules.Shelf.csproj" />
  </ItemGroup>

</Project>
