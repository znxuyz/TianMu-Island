<Window x:Class="TianMu.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天幕島"
        Width="640" Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SansFont}">

    <!--
      整個視窗是一塊「透明畫布」，只有中間的天幕膠囊是實體。
      AllowsTransparency=True 會讓 Windows 以像素為單位做命中測試：
      透明的地方滑鼠自動穿透，不會擋住底下的視窗。
    -->
    <Grid>
        <Border x:Name="Capsule"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                Width="180" Height="34"
                CornerRadius="17"
                Background="{StaticResource LacquerBrush}"
                BorderThickness="0"
                Cursor="Hand"
                MouseEnter="Capsule_MouseEnter"
                MouseLeave="Capsule_MouseLeave"
                MouseLeftButtonDown="Capsule_MouseLeftButtonDown"
                MouseLeftButtonUp="Capsule_MouseLeftButtonUp">


            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270"
                                  Color="#000000" Opacity="0.42" RenderingBias="Performance" />
            </Border.Effect>

            <Border.ContextMenu>
                <ContextMenu Style="{StaticResource TianMu.ContextMenu}">
                    <MenuItem Style="{StaticResource TianMu.MenuItem}" Header="開啟設定" Click="Settings_Click" />
                    <MenuItem Style="{StaticResource TianMu.MenuItem}" Header="暫時隱藏天幕" Click="Hide_Click" />
                    <Separator Style="{StaticResource TianMu.Separator}" />
                    <MenuItem Style="{StaticResource TianMu.MenuItem}" Header="結束天幕島" Click="Exit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid x:Name="ContentRoot">

                <!-- 描金頂線：唯一的光源來自正上方 -->
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource TopHairlineBrush}"
                           IsHitTestVisible="False" Panel.ZIndex="10" />

                <!-- 收合態 -->
                <Grid x:Name="IdleLayer">
                    <!-- 預設：左側靈氣呼吸點 + 右側時辰 -->
                    <Grid x:Name="DefaultCompact">
                        <Ellipse x:Name="SpiritDot"
                                 Width="7" Height="7"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="15,0,0,0"
                                 Fill="{StaticResource MiaoJinBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#C8A869" Opacity="0.85" />
                            </Ellipse.Effect>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.3" Duration="0:0:1.6">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <TextBlock x:Name="ClockText"
                                   Text="00:00"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   FontFamily="{StaticResource SerifMediumFont}"
                                   FontSize="14"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <!-- 法器自訂的收合畫面（例如：封面 + 迷你頻譜） -->
                    <ContentControl x:Name="CompactHost" Focusable="False" IsTabStop="False"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Grid>

                <!-- 展開態 -->
                <Grid x:Name="ExpandedLayer" Opacity="0" Visibility="Hidden">
                    <!-- 預設：主標題 + 副標題 -->
                    <Grid x:Name="DefaultExpanded">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Text="天幕島"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource SerifMediumFont}"
                                       FontSize="38"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{StaticResource YueBaiBrush}" />
                            <TextBlock x:Name="SubtitleText"
                                       Text="靈台初開"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- 縱書時辰：直排點綴於右側 -->
                        <TextBlock x:Name="ShichenText"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,24,0"
                                   FontFamily="{StaticResource SerifFont}"
                                   FontSize="14" FontWeight="Bold"
                                   TextAlignment="Center"
                                   LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource MiaoJinBrush}" />
                    </Grid>

                    <!-- 法器自訂的展開畫面（例如：音樂面板） -->
                    <ContentControl x:Name="ExpandedHost" Focusable="False" IsTabStop="False"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
