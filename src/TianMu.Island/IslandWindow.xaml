<Window x:Class="TianMu.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天幕島"
        Width="640" Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="{StaticResource SansFont}">

    <!--
      整個視窗是一塊「透明畫布」，只有中間的天幕膠囊是實體。
      AllowsTransparency=True 會讓 Windows 以像素為單位做命中測試：
      透明的地方滑鼠自動穿透，不會擋住底下的視窗。
    -->
    <Grid x:Name="Stage">
        <!-- 靈氣粒子：閒置時金塵從膠囊兩端飄散（不擋滑鼠） -->
        <Canvas x:Name="ParticleLayer" IsHitTestVisible="False" />

        <!-- 水滴融合：兩個常駐異象同時存在時，天幕分出一顆小圓（分身），中間以水滴頸相連 -->
        <Canvas x:Name="GooLayer">
            <Path x:Name="GooNeck" Fill="{StaticResource LacquerBrush}" IsHitTestVisible="False" />
            <Border x:Name="Satellite" Width="32" Height="32" CornerRadius="16" Visibility="Collapsed"
                    Background="{StaticResource LacquerBrush}" Cursor="Hand"
                    MouseLeftButtonUp="Satellite_MouseLeftButtonUp" ToolTip="點一下切換到這個畫面">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.35"
                                      RenderingBias="Performance" />
                </Border.Effect>
                <ContentControl x:Name="SatelliteHost" Focusable="False" IsTabStop="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Canvas>

        <Border x:Name="Capsule"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0"
                Width="180" Height="34"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                MouseMove="Capsule_MouseMove"
                AllowDrop="True"
                DragEnter="Capsule_DragEnter"
                DragOver="Capsule_DragOver"
                DragLeave="Capsule_DragLeave"
                Drop="Capsule_Drop"
                MouseWheel="Capsule_MouseWheel"
                MouseEnter="Capsule_MouseEnter"
                MouseLeave="Capsule_MouseLeave"
                MouseLeftButtonDown="Capsule_MouseLeftButtonDown"
                MouseLeftButtonUp="Capsule_MouseLeftButtonUp">


            <Border.Effect>
                <DropShadowEffect x:Name="CapsuleShadow" BlurRadius="28" ShadowDepth="6" Direction="270"
                                  Color="#000000" Opacity="0.42" RenderingBias="Performance" />
            </Border.Effect>

            <Border.ContextMenu>
                <ContextMenu x:Name="CapsuleMenu" Style="{StaticResource TianMu.ContextMenu}" Opened="CapsuleMenu_Opened">
                    <MenuItem Style="{StaticResource TianMu.MenuItem}" Header="開啟設定" Click="Settings_Click" />
                    <MenuItem Style="{StaticResource TianMu.MenuItem}" Header="暫時隱藏天幕" Click="Hide_Click" />
                    <Separator Style="{StaticResource TianMu.Separator}" />
                    <MenuItem Style="{StaticResource TianMu.MenuItem}" Header="結束天幕島" Click="Exit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid x:Name="Body">
            <!--
              天幕形體：貼齊上緣時上方是平的，兩肩向外彎出（像瀏海）；側邊停靠時是圓膠囊。
              兩肩的曲面畫在膠囊範圍之外，所以放在 Canvas 裡：Canvas 不會依版面裁切子元素，
              直接放在 Grid 裡的話曲面會被切掉、看起來變成直角。
            -->
            <Canvas IsHitTestVisible="False">
                <Path x:Name="CapsuleShape" Fill="{StaticResource LacquerBrush}" IsHitTestVisible="False" />
            </Canvas>

            <Grid x:Name="ContentRoot">

                <!-- 金丹光暈（金丹境以上）：膠囊中心透出微暖的光 -->
                <Ellipse x:Name="CoreGlow" Width="150" Height="70" Visibility="Collapsed" IsHitTestVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#40C8A869" Offset="0" />
                            <GradientStop Color="#00C8A869" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- 狀態燈（例如麥克風、相機使用中）：收合時是下緣正中的小光點，展開時是右上角的小圖示 -->
                <StackPanel x:Name="IndicatorPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" Margin="0,0,0,3" Panel.ZIndex="12" />

                <!-- 拖放提示：把檔案拖到天幕上時出現 -->
                <!-- 拖放提示：袋口張開，金色漩渦把檔案吸進去 -->
                <Border x:Name="DropHint" Visibility="Collapsed" Panel.ZIndex="18" Background="#F20E0C0A"
                        IsHitTestVisible="False">
                    <StackPanel x:Name="DropHintContent" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="Vortex" Width="68" Height="68" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="VortexScale" ScaleX="0" ScaleY="0" />
                                    <RotateTransform x:Name="VortexSpin" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#55C8A869" Offset="0" />
                                        <GradientStop Color="#00C8A869" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Path x:Name="VortexArms" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Stroke>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFF0DCA8" Offset="0" />
                                        <GradientStop Color="#CCC8A869" Offset="0.55" />
                                        <GradientStop Color="#00C8A869" Offset="1" />
                                    </RadialGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <Ellipse Width="7" Height="7" Fill="#FFF4EEE2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#E6CF98" Opacity="1" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DropHintText"
                                       FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="17"
                                       Foreground="{StaticResource MiaoJinBrush}" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="放開即收入 · 只記位置，不搬動檔案" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 渡劫雷光 -->
                <Border x:Name="FlashLayer" Background="#FFF4EEE2" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="20" />

                <!-- 描金頂線：唯一的光源來自正上方 -->
                <Rectangle x:Name="TopHairline" Height="1" VerticalAlignment="Top" Fill="{StaticResource TopHairlineBrush}"
                           Opacity="0.7" IsHitTestVisible="False" Panel.ZIndex="10" />

                <!-- 收合態 -->
                <Grid x:Name="IdleLayer">
                    <!-- 預設：左側靈氣呼吸點 + 右側時辰 -->
                    <Grid x:Name="DefaultCompact">
                        <Ellipse x:Name="SpiritDot"
                                 Width="7" Height="7"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="15,0,0,0"
                                 Fill="{StaticResource MiaoJinBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#C8A869" Opacity="0.85" />
                            </Ellipse.Effect>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.3" Duration="0:0:1.6">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- 化神神印 -->
                        <Border x:Name="IdleSeal" Width="15" Height="15" CornerRadius="3" Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,60,0"
                                Background="{StaticResource ZhuShaBrush}">
                            <TextBlock Text="神" FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="9"
                                       Foreground="#FFF4EEE2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock x:Name="ClockText"
                                   Text="00:00"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   FontFamily="{StaticResource SerifMediumFont}"
                                   FontSize="14"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <!-- 直式（停在左右側）：呼吸點在上、時鐘直排在下 -->
                    <StackPanel x:Name="VerticalCompact" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" HorizontalAlignment="Center" Fill="{StaticResource MiaoJinBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#C8A869" Opacity="0.85" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="VerticalClockText" Margin="0,12,0,0" HorizontalAlignment="Center"
                                   TextAlignment="Center" FontFamily="{StaticResource SerifMediumFont}" FontSize="13"
                                   LineHeight="17" LineStackingStrategy="BlockLineHeight"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 法器自訂的收合畫面（例如：封面 + 迷你頻譜） -->
                    <ContentControl x:Name="CompactHost" Focusable="False" IsTabStop="False"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Grid>

                <!-- 展開態 -->
                <Grid x:Name="ExpandedLayer" Opacity="0" Visibility="Hidden">
                    <Grid x:Name="PageContent">
                    <!-- 預設：主標題 + 副標題 -->
                    <Grid x:Name="DefaultExpanded">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Text="天幕島"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource SerifMediumFont}"
                                       FontSize="38"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{StaticResource YueBaiBrush}" />
                            <TextBlock x:Name="SubtitleText"
                                       Text="靈台初開"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- 縱書時辰：直排點綴於右側 -->
                        <TextBlock x:Name="ShichenText"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,24,0"
                                   FontFamily="{StaticResource SerifFont}"
                                   FontSize="14" FontWeight="Bold"
                                   TextAlignment="Center"
                                   LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource MiaoJinBrush}" />

                        <!-- 捷徑列：左側修為狀態、右側法器捷徑（凝神、飲水…） -->
                        <Grid x:Name="QuickBar" Grid.Row="1" Margin="24,0,18,16" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <StackPanel x:Name="QuickButtons" Grid.Column="1" Orientation="Horizontal" />
                        </Grid>
                    </Grid>

                    <!-- 法器自訂的展開畫面（例如：音樂面板） -->
                    <ContentControl x:Name="ExpandedHost" Focusable="False" IsTabStop="False"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </Grid>

                    <!-- 翻頁：左右箭頭與頁點（展開後切換時辰、樂律、專注、AI 額度…） -->
                    <Grid x:Name="PagerLayer" Visibility="Collapsed">
                        <Button x:Name="PrevPageButton" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                                Style="{StaticResource TianMu.Button.Icon}" Width="28" Height="28" FontSize="10"
                                Content="&#xE76B;" ToolTip="上一頁" AutomationProperties.Name="上一頁" Click="PrevPage_Click" />
                        <Button x:Name="NextPageButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                Style="{StaticResource TianMu.Button.Icon}" Width="28" Height="28" FontSize="10"
                                Content="&#xE76C;" ToolTip="下一頁" AutomationProperties.Name="下一頁" Click="NextPage_Click" />
                        <StackPanel x:Name="PageDots" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom" Margin="0,0,0,9" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Grid>
            </Grid>
        </Border>

        <!-- 渡劫金線：沿膠囊邊緣走一圈 -->
        <Rectangle x:Name="EdgeRun" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                   Stroke="#FFE6CF98" StrokeThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#E6CF98" Opacity="0.9" />
            </Rectangle.Effect>
        </Rectangle>
    </Grid>
</Window>
