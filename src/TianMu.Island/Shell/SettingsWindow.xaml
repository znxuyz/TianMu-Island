<Window x:Class="TianMu.Island.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:TianMu.Island.Theme"
        xmlns:shell="clr-namespace:TianMu.Island.Shell"
        Title="天幕島設定"
        Width="540" Height="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{StaticResource XuanQiBrush}"
        Foreground="{StaticResource YueBaiBrush}"
        FontFamily="{StaticResource SansFont}"
        Icon="/TianMuIsland;component/Assets/TianMu.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="72" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 區段標題：描金宋體、寬字距 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MiaoJinBrush}" />
            <Setter Property="Margin" Value="0,28,0,6" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource YueBaiBrush}" />
        </Style>
        <Style x:Key="RowDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        </Style>

        <!-- 選擇題的按鈕：選中時描金 -->
        <Style x:Key="ChoiceChip" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="12" Padding="12,4" Background="{StaticResource HoverFillBrush}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource GoldFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource GoldFillBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource MiaoJinBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource MiaoJinBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字輸入框：玄漆底、聚焦時描金邊 -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource YueBaiBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource MiaoJinBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource MiaoJinBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" CornerRadius="8" Background="{StaticResource HoverFillBrush}"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MiaoJinBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource LacquerBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 頂緣描金線 -->
        <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource TopHairlineBrush}" />

        <!-- ═══ 標頭（同時是視窗拖曳區） ═══ -->
        <Grid Margin="32,22,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 朱砂方印：全畫面唯一的重彩 -->
            <Border Width="40" Height="40" CornerRadius="5" Background="{StaticResource ZhuShaBrush}" VerticalAlignment="Center">
                <Border Margin="3" CornerRadius="3" BorderThickness="1" BorderBrush="#66F4EEE2">
                    <TextBlock Text="幕" FontFamily="{StaticResource SerifFont}" FontWeight="Bold" FontSize="20"
                               Foreground="#FFF4EEE2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock theme:Typo.SpacedText="天幕島" FontFamily="{StaticResource SerifFont}" FontWeight="Bold"
                           FontSize="22" Foreground="{StaticResource YueBaiBrush}" />
                <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}">
                    <Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text=" · 設定" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource TianMu.Button.Icon}" Content="&#xE921;" ToolTip="最小化"
                        AutomationProperties.Name="最小化" WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Minimize_Click" />
                <Button Style="{StaticResource TianMu.Button.Icon}" Content="&#xE8BB;" ToolTip="關閉"
                        AutomationProperties.Name="關閉" WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- ═══ 內容 ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="32,0,32,32">

                <!-- 需要重新啟動的提示 -->
                <Border x:Name="RestartBanner" Visibility="Collapsed" Margin="0,16,0,0" Padding="16,12"
                        CornerRadius="14" Background="{StaticResource GoldFillBrush}"
                        BorderThickness="1" BorderBrush="#4DC8A869">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="法器變更將在重新啟動後生效" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource MiaoJinBrush}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource TianMu.Button.Primary}"
                                Content="重新啟動" Click="Restart_Click" />
                    </Grid>
                </Border>

                <!-- ═══ 一般 ═══ -->
                <TextBlock Style="{StaticResource SectionTitle}" theme:Typo.SpacedText="一般" />
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="開機時自動啟動" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="登入 Windows 後，天幕自動垂落於螢幕頂端。" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource TianMu.Toggle}" VerticalAlignment="Center"
                                  Margin="16,0,0,0" AutomationProperties.Name="開機時自動啟動"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="靈氣粒子" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="閒置一分鐘後，金塵自膠囊兩端緩緩飄散；境界越高越多。" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource TianMu.Toggle}" VerticalAlignment="Center"
                                  Margin="16,0,0,0" AutomationProperties.Name="靈氣粒子"
                                  IsChecked="{Binding ShowParticles, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="全螢幕時自動隱藏" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="看影片、玩遊戲或簡報時天幕自動退下，結束後回來。" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource TianMu.Toggle}" VerticalAlignment="Center"
                                  Margin="16,0,0,0" AutomationProperties.Name="全螢幕時自動隱藏"
                                  IsChecked="{Binding AutoHideFullscreen, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="磁吸" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="滑鼠靠近時，天幕微微朝游標偏移，像被吸過去。" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource TianMu.Toggle}" VerticalAlignment="Center"
                                  Margin="16,0,0,0" AutomationProperties.Name="磁吸"
                                  IsChecked="{Binding Magnetic, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="跟隨滑鼠所在的螢幕" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="接多個螢幕時，滑鼠在另一個螢幕停留一秒，天幕就跟過去。" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource TianMu.Toggle}" VerticalAlignment="Center"
                                  Margin="16,0,0,0" AutomationProperties.Name="跟隨滑鼠所在的螢幕"
                                  IsChecked="{Binding FollowCursorScreen, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="晝夜變色" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="漆面色溫隨時辰流轉：子夜偏墨藍、午時偏暖、黃昏帶赭。" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource TianMu.Toggle}" VerticalAlignment="Center"
                                  Margin="16,0,0,0" AutomationProperties.Name="晝夜變色"
                                  IsChecked="{Binding DayNightTint, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="智慧隱藏" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="閒置時天幕縮成一條細線，幾乎不擋畫面；滑鼠碰到螢幕邊緣或移到它上面就變回來。" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource TianMu.Toggle}" VerticalAlignment="Center"
                                  Margin="16,0,0,0" AutomationProperties.Name="智慧隱藏"
                                  IsChecked="{Binding SmartHide, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="彈簧手感" />
                        <TextBlock Style="{StaticResource RowDescription}" Text="天幕伸縮時的彈性：靈動會像果凍般多晃一下，俐落則乾脆停下。" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ChoiceChip}" GroupName="SpringFeel" Content="靈動"
                                         IsChecked="{Binding SpringLively, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource ChoiceChip}" GroupName="SpringFeel" Content="俐落"
                                         IsChecked="{Binding SpringCrisp, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="專注結界" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="番茄鐘專注時，螢幕邊緣亮起一圈緩緩呼吸的金光，提醒自己正在閉關。" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource TianMu.Toggle}" VerticalAlignment="Center"
                                  Margin="16,0,0,0" AutomationProperties.Name="專注結界"
                                  IsChecked="{Binding FocusBarrier, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- ═══ 法器 ═══ -->
                <TextBlock Style="{StaticResource SectionTitle}" theme:Typo.SpacedText="法器" />
                <ItemsControl ItemsSource="{Binding Modules}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource RowDescription}" Text="{Binding Description}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource TianMu.Toggle}" VerticalAlignment="Center"
                                                  Margin="16,0,0,0" AutomationProperties.Name="{Binding Title}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                    </Grid>

                                    <!-- 法器底下的選項（縮排） -->
                                    <ItemsControl ItemsSource="{Binding Options}" Focusable="False" Margin="18,6,0,0">
                                        <ItemsControl.Resources>
                                            <!-- 選擇題：一排小按鈕 -->
                                            <DataTemplate DataType="{x:Type shell:ChoiceRowViewModel}">
                                                <Grid Margin="0,8,0,0" IsEnabled="{Binding ParentEnabled}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Fill="{StaticResource HairlineBrush}" />
                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                        <TextBlock Style="{StaticResource RowTitle}" FontSize="13" Text="{Binding Title}" />
                                                        <TextBlock Style="{StaticResource RowDescription}" Text="{Binding Description}" />
                                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Items}" Focusable="False">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <RadioButton Style="{StaticResource ChoiceChip}" Content="{Binding Label}"
                                                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>

                                            <!-- 文字選項 -->
                                            <DataTemplate DataType="{x:Type shell:TextRowViewModel}">
                                                <Grid Margin="0,8,0,0" IsEnabled="{Binding ParentEnabled}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Fill="{StaticResource HairlineBrush}" />
                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                        <TextBlock Style="{StaticResource RowTitle}" FontSize="13" Text="{Binding Title}" />
                                                        <TextBlock Style="{StaticResource RowDescription}" Text="{Binding Description}" />
                                                        <Grid Margin="0,8,0,0">
                                                            <TextBox Style="{StaticResource Field}" AutomationProperties.Name="{Binding Title}"
                                                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                            <TextBlock Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                                       FontSize="13" Foreground="{StaticResource TextTertiaryBrush}"
                                                                       Text="{Binding Placeholder}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Value}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>

                                            <!-- 開關 -->
                                            <DataTemplate DataType="{x:Type shell:OptionRowViewModel}">
                                                <Grid Margin="0,8,0,0" IsEnabled="{Binding ParentEnabled}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Fill="{StaticResource HairlineBrush}" />
                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                        <TextBlock Style="{StaticResource RowTitle}" FontSize="13" Text="{Binding Title}" />
                                                        <TextBlock Style="{StaticResource RowDescription}" Text="{Binding Description}" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" Style="{StaticResource TianMu.Toggle}" VerticalAlignment="Center"
                                                              Margin="16,0,0,0" AutomationProperties.Name="{Binding Title}"
                                                              IsChecked="{Binding Value, Mode=TwoWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.Resources>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══ 更新 ═══ -->
                <TextBlock Style="{StaticResource SectionTitle}" theme:Typo.SpacedText="更新" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}">
                                    <Run Text="目前版本 " /><Run Text="{Binding VersionText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource RowDescription}" Text="{Binding UpdateStatus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="CheckButton" Style="{StaticResource TianMu.Button.Ghost}" Content="檢查更新"
                                        IsEnabled="{Binding CanCheck}" Click="Check_Click" />
                                <Button x:Name="InstallButton" Style="{StaticResource TianMu.Button.Primary}" Content="立即更新"
                                        Margin="8,0,0,0" Click="Install_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- 下載進度 -->
                        <Grid x:Name="ProgressTrack" Height="3" Margin="0,12,0,0" Visibility="Collapsed">
                            <Border CornerRadius="1.5" Background="{StaticResource TrackBrush}" />
                            <Border CornerRadius="1.5" Background="{StaticResource MiaoJinBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding UpdateProgress}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="AvailableLinks" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                            <Button Style="{StaticResource TianMu.Button.Ghost}" Content="查看更新內容" Click="ReleasePage_Click" />
                            <Button Style="{StaticResource TianMu.Button.Ghost}" Content="略過此版本" Margin="8,0,0,0" Click="Skip_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="自動檢查更新" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="每天最多向 GitHub 查詢一次；有新版時天幕會提醒你，不會自動安裝。" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource TianMu.Toggle}" VerticalAlignment="Center"
                                  Margin="16,0,0,0" AutomationProperties.Name="自動檢查更新"
                                  IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- ═══ 關於 ═══ -->
                <TextBlock Style="{StaticResource SectionTitle}" theme:Typo.SpacedText="關於" />
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="原始碼" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="天幕島的所有程式碼都在 GitHub 上。" />
                        </StackPanel>
                        <Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                Style="{StaticResource TianMu.Button.Ghost}" Content="開啟 GitHub" Click="Repository_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Row}" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="設定檔資料夾" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="想備份或重設天幕島時用得到。" />
                        </StackPanel>
                        <Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                Style="{StaticResource TianMu.Button.Ghost}" Content="開啟資料夾" Click="Folder_Click" />
                    </Grid>
                </Border>

                <TextBlock x:Name="NoticeText" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource MiaoJinBrush}"
                           TextWrapping="Wrap" Text="{Binding Notice}" />

                <TextBlock Margin="0,28,0,0" HorizontalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource TextTertiaryBrush}" theme:Typo.SpacedText="天幕之下，皆為道場" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
