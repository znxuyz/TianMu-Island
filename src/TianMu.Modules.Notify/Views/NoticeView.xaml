<UserControl x:Class="TianMu.Modules.Notify.Views.NoticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 傳音符：左側一張直書「傳音」的符紙，右側寄件者與內文 -->
    <Grid Margin="14,14,22,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Talisman" Width="32" CornerRadius="6" Background="#FFCDBB8C" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="13"
                       LineHeight="19" LineStackingStrategy="BlockLineHeight"
                       Foreground="#FF5E2618" Text="傳&#x0a;音" />
        </Border>

        <StackPanel Grid.Column="1" Margin="16,2,0,0">
            <Grid>
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource YueBaiBrush}"
                           Text="{Binding Title, NotifyOnTargetUpdated=True}" TextTrimming="CharacterEllipsis" Margin="0,0,90,0">
                    <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- 翻牌：圖示轉過來亮相 -->
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Talisman"
                                                               Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0">
                                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1.15">
                                        <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5" /></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding Source}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Margin="0,6,0,0" FontSize="13" LineHeight="20" MaxHeight="40" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding Body}" />
        </StackPanel>
    </Grid>
</UserControl>
