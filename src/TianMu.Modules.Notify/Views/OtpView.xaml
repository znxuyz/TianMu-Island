<UserControl x:Class="TianMu.Modules.Notify.Views.OtpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 驗證碼：大字分段顯示，整張卡片點一下就複製 -->
    <Button Command="{Binding CopyCommand}" Cursor="Hand" Focusable="False" ToolTip="複製驗證碼"
            AutomationProperties.Name="複製驗證碼">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Card" Background="Transparent" CornerRadius="20" Padding="22,12,22,12">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="12" Foreground="{DynamicResource MiaoJinBrush}" Text="驗證碼" />
                <TextBlock Margin="0,2,0,0" FontFamily="{DynamicResource SerifMediumFont}" FontSize="32"
                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource YueBaiBrush}"
                           Text="{Binding PrettyCode}" />
                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Padding="14,6" CornerRadius="14"
                    BorderThickness="1" BorderBrush="{DynamicResource MiaoJinBrush}">
                <TextBlock FontSize="12" Foreground="{DynamicResource MiaoJinBrush}" Text="{Binding Action}" />
            </Border>
        </Grid>
    </Button>
</UserControl>
