<Project Sdk="Microsoft.NET.Sdk">

  <!--
    法器「AI 額度」：顯示 Claude 訂閱方案的 5 小時與 7 天剩餘額度。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>TianMu.Modules.Ai</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TianMu.Core\TianMu.Core.csproj" />
  </ItemGroup>

  <!-- Windows 資料保護（DPAPI，用來加密 sessionKey）已內建於 .NET 10 的 Windows 桌面框架，不需另外引用套件 -->

  <ItemGroup>
    <InternalsVisibleTo Include="TianMu.Tests" />
  </ItemGroup>

</Project>
