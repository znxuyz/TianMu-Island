<UserControl x:Class="TianMu.Modules.Ai.Views.QuotaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TianMu.Modules.Ai.Views">
    <UserControl.Resources>
        <!-- 已連結時顯示 -->
        <Style x:Key="WhenConnected" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Connected}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 尚未連結時顯示 -->
        <Style x:Key="WhenDisconnected" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Connected}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 標頭的小文字按鈕 -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="9,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MiaoJinBrush}" />
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,14,22,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標頭 -->
        <Grid>
            <TextBlock FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="15"
                       Foreground="{DynamicResource YueBaiBrush}" Text="AI 額度" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource LinkButton}" Content="刷新" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource LinkButton}" Content="連結" Command="{Binding ConnectCommand}" />
            </StackPanel>
        </Grid>

        <!-- 已連結：雙環 + 兩列額度 -->
        <Grid Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource WhenConnected}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 外環 5 小時（描金）、內環 7 天（月白），借鑑健身圓環 -->
            <Grid Width="96" Height="96" VerticalAlignment="Center">
                <local:QuotaRing Thickness="8" Progress="{Binding FiveHourRemaining}"
                                 RingBrush="{DynamicResource MiaoJinBrush}" />
                <local:QuotaRing Margin="12" Thickness="8" Progress="{Binding SevenDayRemaining}"
                                 RingBrush="{DynamicResource YueBaiBrush}" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}" Text="剩餘" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource YueBaiBrush}" Text="Claude" />
                    <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource MiaoJinBrush}" Text="{Binding PlanText}" />
                </StackPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource MiaoJinBrush}" VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0" FontSize="13" Foreground="{DynamicResource YueBaiBrush}" Text="5 小時" />
                        </StackPanel>
                        <TextBlock Margin="13,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding FiveHourReset}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{DynamicResource SerifMediumFont}"
                               FontSize="26" Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource YueBaiBrush}" Text="{Binding FiveHourPercent}" />
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource YueBaiBrush}" VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0" FontSize="13" Foreground="{DynamicResource YueBaiBrush}" Text="7 天" />
                        </StackPanel>
                        <TextBlock Margin="13,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding SevenDayReset}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{DynamicResource SerifMediumFont}"
                               FontSize="26" Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource YueBaiBrush}" Text="{Binding SevenDayPercent}" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 尚未連結：說明 -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center" Style="{StaticResource WhenDisconnected}">
            <TextBlock FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="17"
                       Foreground="{DynamicResource YueBaiBrush}" Text="尚未連結 Claude" />
            <TextBlock Margin="0,6,0,0" FontSize="12" LineHeight="19" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding EmptyHint}" />
        </StackPanel>

        <!-- 狀態列 -->
        <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Status}" />
    </Grid>
</UserControl>
