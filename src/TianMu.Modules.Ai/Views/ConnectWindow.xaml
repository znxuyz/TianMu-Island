<Window x:Class="TianMu.Modules.Ai.Views.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="連結 Claude"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource XuanQiBrush}"
        Foreground="{DynamicResource YueBaiBrush}"
        FontFamily="{DynamicResource SansFont}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource LacquerBrush}">
        <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource TopHairlineBrush}" />

        <StackPanel Margin="28,22,28,24">
            <Grid>
                <TextBlock FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="20" Text="連結 Claude" />
                <Button HorizontalAlignment="Right" Style="{DynamicResource TianMu.Button.Icon}" Content="&#xE8BB;"
                        ToolTip="關閉" AutomationProperties.Name="關閉" WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Close_Click" />
            </Grid>

            <TextBlock Margin="0,14,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="在天幕島裡登入你的 Claude 帳號一次，之後就會自動顯示 5 小時與 7 天的剩餘額度。" />

            <TextBlock x:Name="Status" Margin="0,16,0,0" FontSize="13" Foreground="{DynamicResource YueBaiBrush}" />

            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                <Button x:Name="LoginButton" Style="{DynamicResource TianMu.Button.Primary}" Content="登入 Claude"
                        Click="Login_Click" />
                <Button x:Name="LogoutButton" Margin="8,0,0,0" Style="{DynamicResource TianMu.Button.Ghost}" Content="登出"
                        Click="Logout_Click" />
            </StackPanel>

            <TextBlock x:Name="ClaudeCodeStatus" Margin="0,18,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}" />

            <TextBlock Margin="0,14,0,0" FontSize="11" LineHeight="17" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="登入狀態只存在這台電腦的天幕島資料夾裡，只用來向 claude.ai 查詢額度。Anthropic 沒有公開額度的正式介面，日後若網站改版可能需要更新天幕島。" />
        </StackPanel>
    </Grid>
</Window>
