<UserControl x:Class="TianMu.Modules.Shelf.Views.ShelfBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="22" Height="24">
    <!-- 一疊檔案＋朱砂角標（收合的膠囊與分身小圓共用） -->
    <Grid>
        <Border Width="12" Height="15" CornerRadius="2.5" Margin="4,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#33ECE6D8" />
        <Border Width="12" Height="15" CornerRadius="2.5" Margin="1,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource YueBaiBrush}" BorderBrush="{DynamicResource MiaoJinBrush}" BorderThickness="1" />
        <Border MinWidth="13" Height="13" CornerRadius="6.5" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="{DynamicResource ZhuShaBrush}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" FontWeight="Bold"
                       Foreground="#FFF4EEE2" Text="{Binding CountText}" />
        </Border>
    </Grid>
</UserControl>
