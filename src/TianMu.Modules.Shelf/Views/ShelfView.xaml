<UserControl x:Class="TianMu.Modules.Shelf.Views.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 乾坤袋：拖出去就能用；雙擊開啟；滑過時右上角可移出 -->
    <Grid Margin="18,12,18,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock FontFamily="{DynamicResource SerifFont}" FontWeight="Bold" FontSize="15"
                       Foreground="{DynamicResource YueBaiBrush}" Text="{Binding Title}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Text="拖出即用 · 雙擊開啟" />
                <Button Style="{DynamicResource TianMu.Button.Ghost}" MinHeight="26" Padding="12,0" FontSize="12"
                        Content="清空" Command="{Binding ClearCommand}" Focusable="False" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Tile" Width="74" Height="78" Margin="0,0,6,6" CornerRadius="12"
                                Background="Transparent" Cursor="Hand" ToolTip="{Binding Path}"
                                MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                                MouseMove="Tile_MouseMove">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="32" Height="32" HorizontalAlignment="Center" />
                                    <TextBlock Margin="4,6,4,0" HorizontalAlignment="Center" TextAlignment="Center"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                </StackPanel>
                                <Button x:Name="RemoveButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Width="20" Height="20" Margin="0,2,2,0" Visibility="Hidden"
                                        Style="{DynamicResource TianMu.Button.Icon}" FontSize="8" Content="&#xE711;"
                                        ToolTip="移出乾坤袋（檔案本身不會刪除）" Command="{Binding RemoveCommand}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
